# Anthropic API
ANTHROPIC_API_KEY=

# SEC 要求 User-Agent 带上你的名字和邮箱
SEC_USER_AGENT="Your Name your@email.com"

# IB Gateway 登录（只给 docker-compose 用，不要提交到仓库）
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper

# 可选：出错或对账不一致时推送到手机（ntfy App 订阅同一主题，主题名请随机取）
ALERT_NTFY_URL=

# 币圈：OKX API（只开“读取 + 交易”，不要开提币；绑定 IP 白名单）
# sandbox: true 时填 OKX 模拟盘（Demo Trading）里创建的 key
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# 真钱交易的最后一道确认，只有你自己决定要上实盘时才改成 yes
CRYPTO_ALLOW_LIVE=
